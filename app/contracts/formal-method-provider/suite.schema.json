{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sunmoonai.com/knowlab/formal-method/v1/suite.schema.json",
  "$defs": {
    "ApproxAssertion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "approx",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "maxLength": 512,
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "absolute_tolerance": {
          "minimum": 0,
          "title": "Absolute Tolerance",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "pointer",
        "value",
        "absolute_tolerance"
      ],
      "title": "ApproxAssertion",
      "type": "object"
    },
    "ContainsAssertion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "contains",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "maxLength": 512,
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "value": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "pointer",
        "value"
      ],
      "title": "ContainsAssertion",
      "type": "object"
    },
    "EqualsAssertion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "equals",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "maxLength": 512,
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "kind",
        "pointer",
        "value"
      ],
      "title": "EqualsAssertion",
      "type": "object"
    },
    "FormalCaseExpectation": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "succeeded",
            "rejected"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "rejection_code": {
          "anyOf": [
            {
              "enum": [
                "authorization_denied",
                "approval_denied",
                "input_invalid"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Code"
        },
        "assertions": {
          "items": {
            "discriminator": {
              "mapping": {
                "approx": "#/$defs/ApproxAssertion",
                "contains": "#/$defs/ContainsAssertion",
                "equals": "#/$defs/EqualsAssertion"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/EqualsAssertion"
              },
              {
                "$ref": "#/$defs/ApproxAssertion"
              },
              {
                "$ref": "#/$defs/ContainsAssertion"
              }
            ]
          },
          "maxItems": 64,
          "title": "Assertions",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "assertions"
      ],
      "title": "FormalCaseExpectation",
      "type": "object"
    },
    "FormalCaseInput": {
      "additionalProperties": false,
      "properties": {
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 100,
          "title": "Values",
          "type": "object"
        },
        "model_prompt": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Prompt"
        }
      },
      "required": [
        "values"
      ],
      "title": "FormalCaseInput",
      "type": "object"
    },
    "FormalExecutionCase": {
      "additionalProperties": false,
      "properties": {
        "covers_promises": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Covers Promises",
          "type": "array"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9_-]{1,48}$",
          "title": "Case Id",
          "type": "string"
        },
        "caller": {
          "default": "host",
          "enum": [
            "host",
            "model"
          ],
          "title": "Caller",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/FormalCaseInput"
        },
        "repetitions": {
          "maximum": 10,
          "minimum": 1,
          "title": "Repetitions",
          "type": "integer"
        },
        "minimum_passes": {
          "maximum": 10,
          "minimum": 1,
          "title": "Minimum Passes",
          "type": "integer"
        },
        "expected": {
          "$ref": "#/$defs/FormalCaseExpectation"
        }
      },
      "required": [
        "case_id",
        "input",
        "repetitions",
        "minimum_passes",
        "expected"
      ],
      "title": "FormalExecutionCase",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "suite_id": {
      "format": "uuid",
      "title": "Suite Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/FormalExecutionCase"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Digest",
      "type": "string"
    }
  },
  "required": [
    "suite_id",
    "version",
    "cases",
    "digest"
  ],
  "title": "FormalTestSuite",
  "type": "object"
}
